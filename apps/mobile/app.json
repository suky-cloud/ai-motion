{
  "expo": {
    "name": "AI Motion",
    "slug": "ai-motion",
    "scheme": "aimotion",
    "plugins": [
      "./plugins/withAndroidBaseline",
      "expo-sqlite",
      "./plugins/withLocalSync"
    ],
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.sukycloud.aimotion",
      "versionCode": 3,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_LOCAL_NETWORK"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "infoPlist": {
        "NSCameraUsageDescription": "AI Motion 使用摄像头在本机进行运动互动。"
      }
    }
  }
}
